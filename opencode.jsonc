{
  "$schema": "https://opencode.ai/config.json",

  // AGENTS.md is discovered automatically. This adds the build/test facts that
  // are not in AGENTS.md (JDK path, Gradle tasks, verification expectations).
  "instructions": [".opencode/instructions/android.md"],

  // Defined here (rather than as .opencode/commands/*.md) because this install
  // does not register the Markdown command files for this project.
  // JAVA_HOME is set inline: each shell tool call is a fresh process.
  "commands": {
    "build": {
      "description": "Build the MyTrolley Android debug APK with the Android Studio JDK",
      "template": "Build the Android app from the project root. Run this exact PowerShell command; JAVA_HOME must be set in the same process because each shell call is fresh:\n\n$env:JAVA_HOME = 'C:\\Program Files\\Android\\Android Studio\\jbr'; .\\gradlew.bat :app:assembleDebug\n\nReport the outcome verbatim. Do not modify any source, build, or configuration files."
    },
    "test": {
      "description": "Run the existing MyTrolley Android unit tests",
      "template": "Run the Android unit tests from the project root. Set JAVA_HOME in the same process because each shell call is fresh:\n\n$env:JAVA_HOME = 'C:\\Program Files\\Android\\Android Studio\\jbr'; .\\gradlew.bat :app:testDebugUnitTest\n\nReport the outcome verbatim. Do not modify any source, build, or configuration files."
    },
    "verify": {
      "description": "Build the Android app and run its existing unit tests",
      "template": "Run the Android verification sequence from the project root. Set JAVA_HOME in each command because shell calls are separate processes:\n\n$env:JAVA_HOME = 'C:\\Program Files\\Android\\Android Studio\\jbr'; .\\gradlew.bat :app:assembleDebug\n$env:JAVA_HOME = 'C:\\Program Files\\Android\\Android Studio\\jbr'; .\\gradlew.bat :app:testDebugUnitTest\n\nStop on the first failure and report it verbatim. Do not change files, do not substitute tasks or JDK, and do not claim success without real command output."
    }
  },

  // Gradle and IDE caches are generated noise, not useful context.
  "watcher": {
    "ignore": [
      ".gradle/**",
      ".idea/**",
      ".kotlin/**",
      "build/**",
      "app/build/**"
    ]
  },

  // Base policy allows normal work; these rules add the AGENTS.md guardrails.
  // The last matching rule wins, so keep broad rules before specific ones.
  "permissions": [
    // Rule 18: ask before touching anything outside this Android project.
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Rules 7 and 8: networking and security configuration needs approval.
    { "action": "edit", "resource": "app/src/*/java/com/mytrolley/app/data/remote/*.kt", "effect": "ask" },
    { "action": "edit", "resource": "app/src/*/AndroidManifest.xml", "effect": "ask" },
    { "action": "edit", "resource": "app/src/*/res/xml/network_security_config.xml", "effect": "ask" },

    // Rules 14 and 15: dependencies, SDK versions and build config need approval.
    { "action": "edit", "resource": "app/build.gradle.kts", "effect": "ask" },
    { "action": "edit", "resource": "build.gradle.kts", "effect": "ask" },
    { "action": "edit", "resource": "settings.gradle.kts", "effect": "ask" },
    { "action": "edit", "resource": "gradle/libs.versions.toml", "effect": "ask" },
    { "action": "edit", "resource": "gradle/wrapper/*", "effect": "ask" },
    { "action": "edit", "resource": "local.properties", "effect": "ask" },
    { "action": "read", "resource": "local.properties", "effect": "ask" },

    // Rule 16: never delete tests or weaken assertions without review.
    { "action": "edit", "resource": "app/src/test/**", "effect": "ask" },
    { "action": "edit", "resource": "app/src/androidTest/**", "effect": "ask" },

    // Rule 17: block destructive Git operations outright.
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "deny" },
    { "action": "shell", "resource": "git restore *", "effect": "deny" }
  ]
}
